{% include 'partials/head.liquid' %}
{% comment %} dynamische data kan ik later gebruiken {% endcomment %}
{% comment %}
  {% for item in items %}
      {% assign ID = item.link | split: "/" %}
  <article>
      <h2>{{ item.title }}</h2>
      <p>{{ item.description }}</p>
      <a href="/categorie/{{ID[5]}}">{{ item.title }}</a>
  </article>
  {%  endfor %}
{% endcomment %}
<main>
