{% include 'partials/head.liquid' %}
{% comment %} dynamische data kan ik later gebruiken {% endcomment %}
{% comment %}
  {% for item in items %}
      {% assign ID = item.link | split: "/" %}
  <article>
      <h2>{{ item.title }}</h2>
      <p>{{ item.description }}</p>
      <a href="/categorie/{{ID[5]}}">{{ item.title }}</a>
  </article>
  {%  endfor %}
{% endcomment %}
<main>
  {% comment %} de eerste 4 kaartjes {% endcomment %}
  <section class="small-cards">
    <img class="small-card-img img-total-topics" src="/assets/totaal-topics.svg" alt="icoon van Totaal topics kaartje">
    <h2>1450</h2>
    <p>Totaal topics</p>
    <p>12.5%<span> vs gisteren</span></p>
  </section>

  <section class="small-cards">
    <img class="small-card-img img-active-topics" src="/assets/actieve-topics.svg" alt="icoon van Actieve topics kaartje">
    <h2>125</h2>
    <p>Actieve topics</p>
    <p>8.3%<span> vs gisteren</span></p>
  </section>
  
  <section class="small-cards">
    <img class="small-card-img img-most-active-user" src="/assets/meest-actieve-gebruikers.svg" alt="icoon van Meest actieve gebruikers kaartje">
    <h2>450</h2>
    <p>Meest actieve gebruikers</p>
    <p>15.2%<span> vs gisteren</span></p>
    <a href="/active-users"><img src="assets/Drop-Down-Menu-Indicator.svg" aria-label="Naar active-users pagina"></a>
  </section>

  <section class="small-cards">
    <img class="small-card-img img-account-circle" src="/assets/account_circle.svg" alt="icoon van Reacties van afgelopen week kaartje">
    <h2>890</h2>
    <p>Reacties van afgelopen week</p>
    <p>6.7%<span> vs gisteren</span></p>
  </section>

  {% comment %} grafiek "top actieve gebruikers" {% endcomment %}
  <section class="top-topics-card">
    <h2>Top actieve topics</h2>

    <div class="topic-list">
      {% comment %} topic: AM5: Ervaring en Discussie {% endcomment %}
         {% for item in items %}
        <label class="topic-245">{{ item.title }}</label>
        <meter min="0" max="30000" value="{{ item.replies }}">{{ item.replies }}</meter>
        <p>{{ item.replies }}</p>
        {% endfor %}
    </div>
  </section>

  {% comment %} Trending topics {% endcomment %}
  <div class="grid-container">
    <section class="smallest-colmn">
      <img class="img-active-topics-small" src="/assets/actieve-topics.svg" alt="icoon van Trending topics kaartje">
      <h2 class="smallest-colmn-h2">Trending topics</h2>
      <p class="smallest-colmn-p">Nvidia Blackwell GPU’s officeel aangekondigd</p>
    </section>

    {% comment %} Top gebruikers {% endcomment %}
    <section class="top-user-card">
      <h2>Top gebruikers</h2>
      <ul class="top-user-list">
        {% for user in users %}
          <li class="top-user-item">
            <span class="user-name">{{ user.username }}</span>
            <div class="amount-topics">TBA</div>
            <span class="user-comment">{{ user.number_of_posts }} Reacties</span>
          </li>
        {% endfor %}
      </ul>
    </section>

    {% comment %} Meest gebruikte categorie {% endcomment %}
    <section class="most-used-category">
      <img class="img-most-used-cat" src="/assets/Files-Tweaker.svg" alt="icoon van Meest gebruikte categorie kaartje">
      <p>35% van alle topics</p>
      <h2 class="h2-most-used-cat">Hardware</h2>
      <p>Meest gebruikte categorie</p>
    </section>

    <section class="last-topic-card">
      <h2 class="h2-last-topic">Laatste topic</h2>
      <ul class="last-topic-list">
        <li class="last-topic-item">
          <span class="topic">Wat zie jij aan je bureau? Deel 32</span>
          <div class="last-topic-user">Door Jeroen207</div>
          <span class="last-topic-time">2m geleden</span>
        </li>

        <li class="last-topic-item">
          <span class="topic">Intel 14th gen instabiliteit problemen</span>
          <div class="last-topic-user">Door Verwijderd</div>
          <span class="last-topic-time">8m geleden</span>
        </li>

        <li class="last-topic-item">
          <span class="topic">Budget PC voor 1080 gaming</span>
          <div class="last-topic-user">Door BudgetBuilder</div>
          <span class="last-topic-time">15m geleden</span>
        </li>
      </ul>
    </section>
  </div>
</main>

{% include 'partials/foot.liquid' %}
